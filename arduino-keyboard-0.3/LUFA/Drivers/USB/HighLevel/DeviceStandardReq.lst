 178:LUFA/Drivers/USB/HighLevel/DeviceStandardReq.c **** 	else if (MemoryAddressSpace == MEMSPACE_EEPROM)
 179:LUFA/Drivers/USB/HighLevel/DeviceStandardReq.c **** 	{
