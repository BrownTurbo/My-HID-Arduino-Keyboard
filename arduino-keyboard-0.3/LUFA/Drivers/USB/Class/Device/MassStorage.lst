 203:LUFA/Drivers/USB/Class/Device/MassStorage.c **** 		
 204:LUFA/Drivers/USB/Class/Device/MassStorage.c **** 		if (MSInterfaceInfo->State.IsMassStoreReset)
 205:LUFA/Drivers/USB/Class/Device/MassStorage.c **** 		  return;
