/** \file
 *
 *  USB Device Descriptors, for library use when in USB device mode. Descriptors are special 
 *  computer-readable structures which the host requests upon device enumeration, to determine
 *  the device's capabilities and functions.  
 */

#include "Descriptors.h"
#include <LUFA/Drivers/USB/Class/HID.h>

/** HID class report descriptor. This is a special descriptor constructed with values from the
 *  USBIF HID class specification to describe the reports and capabilities of the HID device. This
 *  descriptor is parsed by the host and its contents used to determine what data (and in what encoding)
 *  the device will send, and what it may be sent back from the host. Refer to the HID specification for
 *  more details on HID report descriptors.
 */
That massive wall of errors is happening because of a LUFA version mismatch.

The errors—specifically implicit declaration of function and initializer element is not constant—mean the C compiler doesn't recognize the HID_RI_* macros. Because it doesn't recognize them, it assumes they are function calls. In C, you cannot use runtime function calls to initialize a static, globally stored PROGMEM array, which triggers the compilation failure.

The core firmware you are running is based on Darran Hunt’s 2011 branch of the LUFA library (version 100807 or 101122). Those older legacy versions of LUFA do not natively include the modern HID_RI_* human-readable macros in their header chains.
The Bulletproof Fix: Raw Hex Compilation

Since you enjoy complex, low-level C programming, the cleanest and most bulletproof way to fix this without tearing apart your compiler's dependency tree is to bypass the macros entirely and feed the compiler the raw, pre-compiled USB HID bytecode.

This is exactly what those macros compile down to behind the scenes.

Replace your KeyboardReport and MediaReport arrays inside Descriptors.c with these raw hex equivalents:
C

// ---------------------------------------------------------
// Interface 0: Standard Keyboard HID Report Descriptor
// ---------------------------------------------------------
const USB_Descriptor_HIDReport_Datatype_t PROGMEM KeyboardReport[] =
{
    0x05, 0x01,          /* Usage Page (Generic Desktop) */
    0x09, 0x06,          /* Usage (Keyboard) */
    0xA1, 0x01,          /* Collection (Application) */
    
    /* Modifiers (8 bits) */
    0x05, 0x07,          /* Usage Page (Key Codes) */
    0x19, 0xE0,          /* Usage Minimum (Keyboard LeftControl) */
    0x29, 0xE7,          /* Usage Maximum (Keyboard Right GUI) */
    0x15, 0x00,          /* Logical Minimum (0) */
    0x25, 0x01,          /* Logical Maximum (1) */
    0x75, 0x01,          /* Report Size (1 bit) */
    0x95, 0x08,          /* Report Count (8 fields) */
    0x81, 0x02,          /* Input (Data, Variable, Absolute) */
    
    /* Reserved Byte (1 byte padding) */
    0x95, 0x01,          /* Report Count (1 field) */
    0x75, 0x08,          /* Report Size (8 bits) */
    0x81, 0x03,          /* Input (Constant, Variable, Absolute) */
    
    /* LED Status Outputs (5 bits) */
    0x05, 0x08,          /* Usage Page (LEDs) */
    0x19, 0x01,          /* Usage Minimum (Num Lock) */
    0x29, 0x05,          /* Usage Maximum (Kana) */
    0x95, 0x05,          /* Report Count (5 fields) */
    0x75, 0x01,          /* Report Size (1 bit) */
    0x91, 0x02,          /* Output (Data, Variable, Absolute) */
    
    /* LED Padding (3 bits) */
    0x95, 0x01,          /* Report Count (1 field) */
    0x75, 0x03,          /* Report Size (3 bits) */
    0x91, 0x03,          /* Output (Constant, Variable, Absolute) */
    
    /* Keycode Array (6 bytes) */
    0x15, 0x00,          /* Logical Minimum (0) */
    0x25, 0xFF,          /* Logical Maximum (255) */
    0x05, 0x07,          /* Usage Page (Key Codes) */
    0x19, 0x00,          /* Usage Minimum (0) */
    0x29, 0xFF,          /* Usage Maximum (255) */
    0x95, 0x06,          /* Report Count (6 fields) */
    0x75, 0x08,          /* Report Size (8 bits) */
    0x81, 0x00,          /* Input (Data, Array, Absolute) */
    
    0xC0                 /* End Collection */
};

const USB_Descriptor_HIDReport_Datatype_t PROGMEM MediaReport[] =
{
    0x05, 0x0C,          /* Usage Page (Consumer) */
    0x09, 0x01,          /* Usage (Consumer Control) */
    0xA1, 0x01,          /* Collection (Application) */
    
    0x15, 0x00,          /* Logical Minimum (0) */
    0x26, 0xFF, 0x03,    /* Logical Maximum (1023) - 16-bit little endian */
    0x19, 0x00,          /* Usage Minimum (0) */
    0x2A, 0xFF, 0x03,    /* Usage Maximum (1023) - 16-bit little endian */
    0x75, 0x10,          /* Report Size (16 bits) */
    0x95, 0x01,          /* Report Count (1 field) */
    0x81, 0x00,          /* Input (Data, Array, Absolute) */
    
    0xC0                 /* End Collection */
};

/** Device descriptor structure. This descriptor, located in FLASH memory, describes the overall
 *  device characteristics, including the supported USB version, control endpoint size and the
