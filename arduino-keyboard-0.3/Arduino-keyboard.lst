 164:Arduino-keyboard.c **** /* ---------------------------------------------------------
 165:Arduino-keyboard.c ****  * Asynchronous Circular Queues (Type-Safe)
 166:Arduino-keyboard.c ****  * --------------------------------------------------------- */
 167:Arduino-keyboard.c **** #define KEYBOARD_QUEUE_SIZE 8
 168:Arduino-keyboard.c **** static USB_KeyboardReport_Data_t KeyboardQueue[KEYBOARD_QUEUE_SIZE];
 169:Arduino-keyboard.c **** static volatile uint8_t KeyboardHead = 0;
 170:Arduino-keyboard.c **** static volatile uint8_t KeyboardTail = 0;
 171:Arduino-keyboard.c **** 
 172:Arduino-keyboard.c **** #define MEDIA_QUEUE_SIZE 16
 173:Arduino-keyboard.c **** static uint16_t MediaQueue[MEDIA_QUEUE_SIZE];
 174:Arduino-keyboard.c **** static volatile uint8_t MediaHead = 0;
 175:Arduino-keyboard.c **** static volatile uint8_t MediaTail = 0;
 176:Arduino-keyboard.c **** 
 177:Arduino-keyboard.c **** // Internal media transmission state management
 178:Arduino-keyboard.c **** typedef enum {
 179:Arduino-keyboard.c ****     MEDIA_IDLE = 0,
 180:Arduino-keyboard.c ****     MEDIA_SEND_RELEASE
 181:Arduino-keyboard.c **** } media_state_t;
 182:Arduino-keyboard.c **** 
 183:Arduino-keyboard.c **** static media_state_t MediaState = MEDIA_IDLE;
 184:Arduino-keyboard.c **** static uint16_t currentMediaUsage = 0;
 185:Arduino-keyboard.c **** uint8_t ledReport = 0;
 186:Arduino-keyboard.c **** 
 187:Arduino-keyboard.c **** /* --- FSM Parser Global Context Variables --- */
 188:Arduino-keyboard.c **** #define SERIAL_PARSER_BUFFER_SIZE 64
 189:Arduino-keyboard.c **** static volatile uint8_t parserBuffer[SERIAL_PARSER_BUFFER_SIZE];
 190:Arduino-keyboard.c **** static volatile uint8_t parserHead  = 0;
 191:Arduino-keyboard.c **** static volatile uint8_t parserTail  = 0;
 192:Arduino-keyboard.c **** static volatile uint8_t parserCount = 0;
 193:Arduino-keyboard.c **** 
 194:Arduino-keyboard.c **** typedef enum {
 195:Arduino-keyboard.c ****     STATE_PARSE_HEADER = 0,
 196:Arduino-keyboard.c ****     STATE_PARSE_PAYLOAD
 197:Arduino-keyboard.c **** } parser_state_t;
 198:Arduino-keyboard.c **** 
 199:Arduino-keyboard.c **** static parser_state_t CurrentParserState = STATE_PARSE_HEADER;
 200:Arduino-keyboard.c **** static uint8_t        ActivePacketType   = 0x00;
 201:Arduino-keyboard.c **** static uint8_t        PayloadByteIndex   = 0;
 202:Arduino-keyboard.c **** 
 203:Arduino-keyboard.c **** // Shared extraction layout matching the 8-byte core payload width
 204:Arduino-keyboard.c **** static union {
 205:Arduino-keyboard.c ****     USB_KeyboardReport_Data_t Keyboard;
 206:Arduino-keyboard.c ****     uint8_t                   RawBytes[sizeof(USB_KeyboardReport_Data_t)];
 207:Arduino-keyboard.c **** } CurrentFrameContext;
 208:Arduino-keyboard.c **** 
 209:Arduino-keyboard.c **** 
 210:Arduino-keyboard.c **** /* ---------------------------------------------------------
 211:Arduino-keyboard.c ****  * Utility Mapping & Queue APIs
 212:Arduino-keyboard.c ****  * --------------------------------------------------------- */
 213:Arduino-keyboard.c **** static inline bool IsMediaUsage(uint8_t usage)
 214:Arduino-keyboard.c **** {
 215:Arduino-keyboard.c ****      return (usage == 0xE9) || /* Volume Up */
 216:Arduino-keyboard.c ****             (usage == 0xEA) || /* Volume Down */
 217:Arduino-keyboard.c ****             (usage == 0xE2) || /* Mute */
 218:Arduino-keyboard.c ****             (usage == 0xCD) || /* Play/Pause */
 219:Arduino-keyboard.c ****             (usage == 0xB5) || /* Next Track */
 220:Arduino-keyboard.c ****             (usage == 0xB6) || /* Prev Track */
 221:Arduino-keyboard.c ****             (usage == 0xB7);    /* Stop */
 222:Arduino-keyboard.c **** }
 223:Arduino-keyboard.c **** 
 224:Arduino-keyboard.c **** static inline uint16_t MapMediaUsage(uint8_t usage)
 225:Arduino-keyboard.c **** {
 226:Arduino-keyboard.c ****      switch (usage)
 227:Arduino-keyboard.c ****      {
 228:Arduino-keyboard.c ****          case 0xE9: return 0x00E9;
 229:Arduino-keyboard.c ****          case 0xEA: return 0x00EA;
 230:Arduino-keyboard.c ****          case 0xE2: return 0x00E2;
 231:Arduino-keyboard.c ****          case 0xCD: return 0x00CD;
 232:Arduino-keyboard.c ****          case 0xB5: return 0x00B5;
 233:Arduino-keyboard.c ****          case 0xB6: return 0x00B6;
 234:Arduino-keyboard.c ****          case 0xB7: return 0x00B7;
 235:Arduino-keyboard.c ****          default:     return 0x0000;
 236:Arduino-keyboard.c ****      }
 237:Arduino-keyboard.c **** }
 238:Arduino-keyboard.c **** 
 239:Arduino-keyboard.c **** static bool KeyboardQueue_Push(const USB_KeyboardReport_Data_t* Report) {
 240:Arduino-keyboard.c ****     uint8_t nextTail = (KeyboardTail + 1) % KEYBOARD_QUEUE_SIZE;
 241:Arduino-keyboard.c ****     if (nextTail == KeyboardHead) return false;
 242:Arduino-keyboard.c ****     KeyboardQueue[KeyboardTail] = *Report;
 243:Arduino-keyboard.c ****     KeyboardTail = nextTail;
 244:Arduino-keyboard.c ****     return true;
 245:Arduino-keyboard.c **** }
 246:Arduino-keyboard.c **** 
 247:Arduino-keyboard.c **** static bool KeyboardQueue_Pop(USB_KeyboardReport_Data_t* Report) {
 248:Arduino-keyboard.c ****     if (KeyboardHead == KeyboardTail) return false;
 249:Arduino-keyboard.c ****     *Report = KeyboardQueue[KeyboardHead];
 250:Arduino-keyboard.c ****     KeyboardHead = (KeyboardHead + 1) % KEYBOARD_QUEUE_SIZE;
 251:Arduino-keyboard.c ****     return true;
 252:Arduino-keyboard.c **** }
