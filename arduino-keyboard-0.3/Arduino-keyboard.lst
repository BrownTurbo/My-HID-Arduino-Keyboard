 297:Arduino-keyboard.c ****             case STATE_PARSE_HEADER:
 298:Arduino-keyboard.c ****                 if (IncomingByte == 0x01 || IncomingByte == 0x02) {
 299:Arduino-keyboard.c ****                     ActivePacketType   = IncomingByte;
