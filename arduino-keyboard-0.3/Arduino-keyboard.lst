 288:Arduino-keyboard.c ****         
 289:Arduino-keyboard.c ****         // Safely extract one byte from the ring buffer
 290:Arduino-keyboard.c ****         ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
 291:Arduino-keyboard.c ****             IncomingByte = parserBuffer[parserTail];
 292:Arduino-keyboard.c ****             parserTail = (parserTail + 1) % SERIAL_PARSER_BUFFER_SIZE;
 293:Arduino-keyboard.c ****             parserCount--;
 294:Arduino-keyboard.c ****         }
 295:Arduino-keyboard.c **** 
