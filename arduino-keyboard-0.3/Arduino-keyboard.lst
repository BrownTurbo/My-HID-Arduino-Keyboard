 238:Arduino-keyboard.c **** static void LoadNextSerialFrameIfAvailable()
 239:Arduino-keyboard.c **** {
 240:Arduino-keyboard.c ****     static uint8_t partial_wait = 0;
 241:Arduino-keyboard.c ****     
 242:Arduino-keyboard.c ****     if (RingBuffer_GetCount(&USARTtoUSB_Buffer) < 8) {
 243:Arduino-keyboard.c ****         partial_wait++;
 244:Arduino-keyboard.c ****         if (partial_wait > 200) {  // ~200 loop iterations with no progress
 245:Arduino-keyboard.c ****             // Flush the buffer to recover
 246:Arduino-keyboard.c ****             while (RingBuffer_GetCount(&USARTtoUSB_Buffer))
 247:Arduino-keyboard.c ****                 (void)RingBuffer_Remove(&USARTtoUSB_Buffer);
 248:Arduino-keyboard.c ****             partial_wait = 0;
 249:Arduino-keyboard.c ****         }
 250:Arduino-keyboard.c ****         return;
 251:Arduino-keyboard.c ****     }
 252:Arduino-keyboard.c ****     partial_wait = 0;
 253:Arduino-keyboard.c **** 
 254:Arduino-keyboard.c ****     for (uint8_t i = 0; i < 8; i++)
 255:Arduino-keyboard.c ****         keyboardData[i] = RingBuffer_Remove(&USARTtoUSB_Buffer);
 256:Arduino-keyboard.c **** 
 257:Arduino-keyboard.c ****     /* If the incoming “keyboard” frame is actually one of your media pseudo-keys,
 258:Arduino-keyboard.c ****        convert it into a Consumer Control action and neutralize the keyboard report. */
 259:Arduino-keyboard.c ****     if (IsMediaUsage(keyboardData[2]))
 260:Arduino-keyboard.c ****     {
 261:Arduino-keyboard.c ****         if (MediaQueue_IsFull())
 262:Arduino-keyboard.c ****         {
 263:Arduino-keyboard.c ****             uint16_t Dummy;
 264:Arduino-keyboard.c ****             MediaQueue_Pop(&Dummy);
 265:Arduino-keyboard.c ****         }
 266:Arduino-keyboard.c ****         MediaQueue_Push(MapMediaUsage(keyboardData[2]));
 267:Arduino-keyboard.c **** 
 268:Arduino-keyboard.c ****         memset(keyboardData, 0, sizeof(keyboardData));
 269:Arduino-keyboard.c ****     }
 270:Arduino-keyboard.c **** }
 271:Arduino-keyboard.c **** 
 272:Arduino-keyboard.c **** /** Main program entry point. This routine contains the overall program flow, including initial
 273:Arduino-keyboard.c ****  *  setup of all components and the main program loop.
 274:Arduino-keyboard.c ****  */
 275:Arduino-keyboard.c **** int main(void)
 276:Arduino-keyboard.c **** {
 277:Arduino-keyboard.c **** 	SetupHardware();
 278:Arduino-keyboard.c **** 
 279:Arduino-keyboard.c **** 	RingBuffer_InitBuffer(&USARTtoUSB_Buffer);
 280:Arduino-keyboard.c **** 
 281:Arduino-keyboard.c **** 	sei();
 282:Arduino-keyboard.c **** 
 283:Arduino-keyboard.c ****     for (;;)
 284:Arduino-keyboard.c ****     {
 285:Arduino-keyboard.c ****         /* Make sure we always have the newest serial frame before generating reports */
 286:Arduino-keyboard.c ****         LoadNextSerialFrameIfAvailable();
 287:Arduino-keyboard.c **** 
 288:Arduino-keyboard.c ****         HID_Device_USBTask(&HID_KeyboardInterface);
 289:Arduino-keyboard.c ****         HID_Device_USBTask(&HID_MediaInterface);
 290:Arduino-keyboard.c **** 
 291:Arduino-keyboard.c ****         USB_USBTask();
 292:Arduino-keyboard.c ****     }
 293:Arduino-keyboard.c **** }
