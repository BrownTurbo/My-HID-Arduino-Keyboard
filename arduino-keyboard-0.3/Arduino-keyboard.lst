 146:Arduino-keyboard.c **** static inline bool IsMediaUsage(uint8_t usage)
 147:Arduino-keyboard.c **** {
 148:Arduino-keyboard.c ****     return (usage == 0xE9) || /* Volume Up */
 149:Arduino-keyboard.c ****            (usage == 0xEA) || /* Volume Down */
 150:Arduino-keyboard.c ****            (usage == 0xE2) || /* Mute */
 151:Arduino-keyboard.c ****            (usage == 0xCD) || /* Play/Pause */
 152:Arduino-keyboard.c ****            (usage == 0xB5) || /* Next Track */
 153:Arduino-keyboard.c ****            (usage == 0xB6) || /* Prev Track */
 154:Arduino-keyboard.c ****            (usage == 0xB7);   /* Stop */
 155:Arduino-keyboard.c **** }
 156:Arduino-keyboard.c **** 
 157:Arduino-keyboard.c **** static inline uint16_t MapMediaUsage(uint8_t usage)
 158:Arduino-keyboard.c **** {
 159:Arduino-keyboard.c ****     switch (usage)
 160:Arduino-keyboard.c ****     {
 161:Arduino-keyboard.c ****         case 0xE9: return 0x00E9;
 162:Arduino-keyboard.c ****         case 0xEA: return 0x00EA;
 163:Arduino-keyboard.c ****         case 0xE2: return 0x00E2;
 164:Arduino-keyboard.c ****         case 0xCD: return 0x00CD;
 165:Arduino-keyboard.c ****         case 0xB5: return 0x00B5;
 166:Arduino-keyboard.c ****         case 0xB6: return 0x00B6;
 167:Arduino-keyboard.c ****         case 0xB7: return 0x00B7;
 168:Arduino-keyboard.c ****         default:    return 0x0000;
 169:Arduino-keyboard.c ****     }
 170:Arduino-keyboard.c **** }
 171:Arduino-keyboard.c **** 
 172:Arduino-keyboard.c **** static bool KeyboardQueue_IsEmpty(void)
 173:Arduino-keyboard.c **** {
 174:Arduino-keyboard.c ****     return KeyboardHead == KeyboardTail;
 175:Arduino-keyboard.c **** }
 176:Arduino-keyboard.c **** 
 177:Arduino-keyboard.c **** static bool KeyboardQueue_IsFull(void)
 178:Arduino-keyboard.c **** {
 179:Arduino-keyboard.c ****     return ((KeyboardTail + 1) % KEYBOARD_QUEUE_SIZE) == KeyboardHead;
 180:Arduino-keyboard.c **** }
 181:Arduino-keyboard.c **** 
 182:Arduino-keyboard.c **** static bool KeyboardQueue_Push(uint16_t Usage)
 183:Arduino-keyboard.c **** {
 184:Arduino-keyboard.c ****     if (KeyboardQueue_IsFull())
 185:Arduino-keyboard.c ****         return false;
 186:Arduino-keyboard.c **** 
 187:Arduino-keyboard.c ****     KeyboardQueue[KeyboardTail] = Usage;
 188:Arduino-keyboard.c ****     KeyboardTail = (KeyboardTail + 1) % KEYBOARD_QUEUE_SIZE;
 189:Arduino-keyboard.c **** 
 190:Arduino-keyboard.c ****     return true;
 191:Arduino-keyboard.c **** }
 192:Arduino-keyboard.c **** 
 193:Arduino-keyboard.c **** static bool KeyboardQueue_Pop(uint16_t* Usage)
 194:Arduino-keyboard.c **** {
 195:Arduino-keyboard.c ****     if (KeyboardQueue_IsEmpty())
 196:Arduino-keyboard.c ****         return false;
 197:Arduino-keyboard.c **** 
 198:Arduino-keyboard.c ****     *Usage = KeyboardQueue[KeyboardHead];
 199:Arduino-keyboard.c **** 
 200:Arduino-keyboard.c ****     KeyboardHead = (KeyboardHead + 1) % KEYBOARD_QUEUE_SIZE;
 201:Arduino-keyboard.c **** 
 202:Arduino-keyboard.c ****     return true;
 203:Arduino-keyboard.c **** }
