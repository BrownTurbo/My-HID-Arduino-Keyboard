 262:Arduino-keyboard.c **** static bool MediaQueue_Pop(uint16_t* Usage) {
 263:Arduino-keyboard.c ****     if (MediaHead == MediaTail) return false;
 264:Arduino-keyboard.c ****     *Usage = MediaQueue[MediaHead];
 265:Arduino-keyboard.c ****     MediaHead = (MediaHead + 1) % MEDIA_QUEUE_SIZE;
 266:Arduino-keyboard.c ****     return true;
 267:Arduino-keyboard.c **** }
