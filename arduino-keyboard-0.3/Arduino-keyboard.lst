 269:Arduino-keyboard.c **** // Atomic helper to calculate available raw streaming bytes
 270:Arduino-keyboard.c **** static inline uint8_t SafeGetParserCount(void) {
 271:Arduino-keyboard.c ****     uint8_t count;
 272:Arduino-keyboard.c ****     ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
 273:Arduino-keyboard.c ****         count = parserCount;
 274:Arduino-keyboard.c ****     }
 275:Arduino-keyboard.c ****     return count;
 276:Arduino-keyboard.c **** }
