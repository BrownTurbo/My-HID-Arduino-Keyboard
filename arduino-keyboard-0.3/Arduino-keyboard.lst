 336:Arduino-keyboard.c **** /* ---------------------------------------------------------
 337:Arduino-keyboard.c ****  * Hardware Polling Loops & LUFA Integration
 338:Arduino-keyboard.c ****  * --------------------------------------------------------- */
 339:Arduino-keyboard.c **** int main(void) {
 340:Arduino-keyboard.c ****     SetupHardware();
 341:Arduino-keyboard.c ****     sei();
 342:Arduino-keyboard.c **** 
 343:Arduino-keyboard.c ****     for (;;) {
 344:Arduino-keyboard.c ****         // Execute background serial pipeline parsing continuously
 345:Arduino-keyboard.c ****         ProcessIncomingSerialData();
 346:Arduino-keyboard.c **** 
 347:Arduino-keyboard.c ****         // Service USB Endpoint transactions synchronously
 348:Arduino-keyboard.c ****         HID_Device_USBTask(&HID_KeyboardInterface);
 349:Arduino-keyboard.c ****         HID_Device_USBTask(&HID_MediaInterface);
 350:Arduino-keyboard.c ****         USB_USBTask();
 351:Arduino-keyboard.c ****     }
 352:Arduino-keyboard.c **** }
 353:Arduino-keyboard.c **** 
