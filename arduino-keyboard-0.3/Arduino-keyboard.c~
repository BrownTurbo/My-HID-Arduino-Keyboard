/** Buffers to hold previously generated HID reports for OS comparison */
uint8_t PrevKeyboardHIDReportBuffer[sizeof(USB_KeyboardReport_Data_t)];
uint8_t PrevMediaHIDReportBuffer[sizeof(USB_MediaReport_Data_t)];

/** Endpoint mapping configurations */
USB_ClassInfo_HID_Device_t HID_KeyboardInterface = {
    .Config = {
        .InterfaceNumber            = 0,
        .ReportINEndpointNumber     = KEYBOARD_EPNUM,
        .ReportINEndpointSize       = KEYBOARD_EPSIZE,
        .ReportINEndpointDoubleBank = false,
        .PrevReportINBuffer         = PrevKeyboardHIDReportBuffer,
        .PrevReportINBufferSize     = sizeof(PrevKeyboardHIDReportBuffer),
    },
};

USB_ClassInfo_HID_Device_t HID_MediaInterface = {
    .Config = {
        .InterfaceNumber            = 1,
        .ReportINEndpointNumber     = MEDIA_EPNUM,
        .ReportINEndpointSize       = MEDIA_EPSIZE,
        .ReportINEndpointDoubleBank = false,
        .PrevReportINBuffer         = PrevMediaHIDReportBuffer,
        .PrevReportINBufferSize     = sizeof(PrevMediaHIDReportBuffer),
    },
};

/* ---------------------------------------------------------
 * Asynchronous Circular Queues (Type-Safe)
 * --------------------------------------------------------- */
#define KEYBOARD_QUEUE_SIZE 8
static USB_KeyboardReport_Data_t KeyboardQueue[KEYBOARD_QUEUE_SIZE];
static volatile uint8_t KeyboardHead = 0;
static volatile uint8_t KeyboardTail = 0;

#define MEDIA_QUEUE_SIZE 16
static uint16_t MediaQueue[MEDIA_QUEUE_SIZE];
static volatile uint8_t MediaHead = 0;
static volatile uint8_t MediaTail = 0;

// Internal media transmission state management
typedef enum {
    MEDIA_IDLE = 0,
    MEDIA_SEND_RELEASE
} media_state_t;

static media_state_t MediaState = MEDIA_IDLE;
static uint16_t currentMediaUsage = 0;
uint8_t ledReport = 0;

/* --- FSM Parser Global Context Variables --- */
#define SERIAL_PARSER_BUFFER_SIZE 64
static volatile uint8_t parserBuffer[SERIAL_PARSER_BUFFER_SIZE];
static volatile uint8_t parserHead  = 0;
static volatile uint8_t parserTail  = 0;
static volatile uint8_t parserCount = 0;

typedef enum {
    STATE_PARSE_HEADER = 0,
    STATE_PARSE_PAYLOAD
} parser_state_t;

static parser_state_t CurrentParserState = STATE_PARSE_HEADER;
static uint8_t        ActivePacketType   = 0x00;
static uint8_t        PayloadByteIndex   = 0;

// Shared extraction layout matching the 8-byte core payload width
static union {
    USB_KeyboardReport_Data_t Keyboard;
    uint8_t                   RawBytes[sizeof(USB_KeyboardReport_Data_t)];
} CurrentFrameContext;


/* ---------------------------------------------------------
 * Utility Mapping & Queue APIs
 * --------------------------------------------------------- */
static inline bool IsMediaUsage(uint8_t usage)
{
     return (usage == 0xE9) || /* Volume Up */
            (usage == 0xEA) || /* Volume Down */
            (usage == 0xE2) || /* Mute */
            (usage == 0xCD) || /* Play/Pause */
            (usage == 0xB5) || /* Next Track */
            (usage == 0xB6) || /* Prev Track */
            (usage == 0xB7);    /* Stop */
}

static inline uint16_t MapMediaUsage(uint8_t usage)
{
     switch (usage)
     {
         case 0xE9: return 0x00E9;
         case 0xEA: return 0x00EA;
         case 0xE2: return 0x00E2;
         case 0xCD: return 0x00CD;
         case 0xB5: return 0x00B5;
         case 0xB6: return 0x00B6;
         case 0xB7: return 0x00B7;
         default:     return 0x0000;
     }
}

static bool KeyboardQueue_Push(const USB_KeyboardReport_Data_t* Report) {
    uint8_t nextTail = (KeyboardTail + 1) % KEYBOARD_QUEUE_SIZE;
    if (nextTail == KeyboardHead) return false;
    KeyboardQueue[KeyboardTail] = *Report;
    KeyboardTail = nextTail;
    return true;
}

static bool KeyboardQueue_Pop(USB_KeyboardReport_Data_t* Report) {
    if (KeyboardHead == KeyboardTail) return false;
    *Report = KeyboardQueue[KeyboardHead];
    KeyboardHead = (KeyboardHead + 1) % KEYBOARD_QUEUE_SIZE;
    return true;
}

static bool MediaQueue_Push(uint16_t Usage) {
    uint8_t nextTail = (MediaTail + 1) % MEDIA_QUEUE_SIZE;
    if (nextTail == MediaHead) return false;
    MediaQueue[MediaTail] = Usage;
    MediaTail = nextTail;
    return true;
}

static bool MediaQueue_Pop(uint16_t* Usage) {
    if (MediaHead == MediaTail) return false;
    *Usage = MediaQueue[MediaHead];
    MediaHead = (MediaHead + 1) % MEDIA_QUEUE_SIZE;
    return true;
}

// Atomic helper to calculate available raw streaming bytes
static inline uint8_t SafeGetParserCount(void) {
    uint8_t count;
    ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
        count = parserCount;
    }
    return count;
}


/* ---------------------------------------------------------
 * FSM Asynchronous Streaming Engine
 * --------------------------------------------------------- */
void ProcessIncomingSerialData(void) {
    // Suspend packet digestion if USB is suspended/disconnected
    if (USB_DeviceState != DEVICE_STATE_Configured) return;

    while (SafeGetParserCount() > 0) {
        uint8_t IncomingByte;
        
        // Safely extract one byte from the ring buffer
        ATOMIC_BLOCK(ATOMIC_RESTORESTATE) {
            IncomingByte = parserBuffer[parserTail];
            parserTail = (parserTail + 1) % SERIAL_PARSER_BUFFER_SIZE;
            parserCount--;
        }

        switch (CurrentParserState) {
            case STATE_PARSE_HEADER:
                if (IncomingByte == 0x01 || IncomingByte == 0x02) {
                    ActivePacketType   = IncomingByte;
                    PayloadByteIndex   = 0;
                    CurrentParserState = STATE_PARSE_PAYLOAD;
                }
                // If invalid header, implicitly fall through and discard byte (auto-realigns)
                break;

            case STATE_PARSE_PAYLOAD:
                CurrentFrameContext.RawBytes[PayloadByteIndex++] = IncomingByte;

                if (PayloadByteIndex >= sizeof(USB_KeyboardReport_Data_t)) {
                    if (ActivePacketType == 0x01) {
                        KeyboardQueue_Push(&CurrentFrameContext.Keyboard);
                    }
                    else if (ActivePacketType == 0x02) {
                        // Extract Media Code mapping
                        uint8_t mediaRaw = CurrentFrameContext.RawBytes[0];
                        if (IsMediaUsage(mediaRaw)) {
                            MediaQueue_Push(MapMediaUsage(mediaRaw));
                        } else if (mediaRaw == 0x00) { // Catch empty release frames
                             MediaQueue_Push(0x0000); 
                        }
                    }
                    // Terminate layout parsing, prepare for next dynamic packet
                    CurrentParserState = STATE_PARSE_HEADER;
                    ActivePacketType   = 0x00;
                    PayloadByteIndex   = 0;
                }
                break;
                
            default:
                CurrentParserState = STATE_PARSE_HEADER;
                break;
        }
    }
}

/* ---------------------------------------------------------
 * Hardware Polling Loops & LUFA Integration
 * --------------------------------------------------------- */
int main(void) {
    SetupHardware();
    sei();

    for (;;) {
        // Execute background serial pipeline parsing continuously
        ProcessIncomingSerialData();

        // Service USB Endpoint transactions synchronously
        HID_Device_USBTask(&HID_KeyboardInterface);
        HID_Device_USBTask(&HID_MediaInterface);
        USB_USBTask();
    }
}

void SetupHardware(void)
{
     /* Disable watchdog if enabled by bootloader/fuses */
     MCUSR &= ~(1 << WDRF);
     wdt_disable();

     /* Hardware Initialization */
     Serial_Init(9600, false);
     USB_Init();

     /* Start the flush timer so that overflows occur rapidly to push received bytes to the USB interface */
     TCCR0B = (1 << CS02);
    
     /* Pull target /RESET line high */
     AVR_RESET_LINE_PORT |= AVR_RESET_LINE_MASK;
     AVR_RESET_LINE_DDR  |= AVR_RESET_LINE_MASK;

     /* Must turn off USART before reconfiguring it, otherwise incorrect operation may occur */
     UCSR1B = 0;
     UCSR1A = 0;
     UCSR1C = 0;

     /* Special case 57600 baud for compatibility with the ATmega328 bootloader. */    
     UBRR1  = SERIAL_2X_UBBRVAL(9600);

     UCSR1C = ((1 << UCSZ11) | (1 << UCSZ10));
     UCSR1A = (1 << U2X1);
     UCSR1B = ((1 << RXCIE1) | (1 << TXEN1) | (1 << RXEN1));
}


/* ---------------------------------------------------------
 * USB Endpoint Transmission Architecture callbacks
 * --------------------------------------------------------- */
bool CALLBACK_HID_Device_CreateHIDReport(
    USB_ClassInfo_HID_Device_t* const HIDInterfaceInfo,
    uint8_t* const ReportID,
    const uint8_t ReportType,
    void* ReportData,
    uint16_t* const ReportSize)
{
    (void)ReportID;
    (void)ReportType;

    // Output mapped matrix layout into Endpoint 1
    if (HIDInterfaceInfo == &HID_KeyboardInterface) {
        USB_KeyboardReport_Data_t activeBufferFrame;

        if (KeyboardQueue_Pop(&activeBufferFrame)) {
            memcpy(ReportData, &activeBufferFrame, sizeof(USB_KeyboardReport_Data_t));
            *ReportSize = sizeof(USB_KeyboardReport_Data_t);
            return true;
        }
        *ReportSize = 0;
        return false;
    }

    // Output consumer command usages into Endpoint 2
    if (HIDInterfaceInfo == &HID_MediaInterface) {
        USB_MediaReport_Data_t* MediaReport = (USB_MediaReport_Data_t*)ReportData;

        if (MediaState == MEDIA_IDLE) {
            if (MediaQueue_Pop(&currentMediaUsage)) {
                MediaReport->Usage = currentMediaUsage;
                MediaState = MEDIA_SEND_RELEASE;
                *ReportSize = sizeof(USB_MediaReport_Data_t);
                return true;
            }
        }
        else if (MediaState == MEDIA_SEND_RELEASE) {
            MediaReport->Usage = 0x0000;
            MediaState = MEDIA_IDLE;
            *ReportSize = sizeof(USB_MediaReport_Data_t);
            return true;
        }

        MediaReport->Usage = 0;
        *ReportSize = sizeof(USB_MediaReport_Data_t);
        return false;
    }

    *ReportSize = 0;
    return false;
}

void CALLBACK_HID_Device_ProcessHIDReport(USB_ClassInfo_HID_Device_t* const HIDInterfaceInfo,
                                          const uint8_t ReportID,
                                          const uint8_t ReportType,
                                          const void* ReportData,
                                          const uint16_t ReportSize)
{ }

void EVENT_USB_Device_ConfigurationChanged(void) {
    HID_Device_ConfigureEndpoints(&HID_KeyboardInterface);
    HID_Device_ConfigureEndpoints(&HID_MediaInterface);
    USB_Device_EnableSOFEvents();
}

void EVENT_USB_Device_UnhandledControlRequest(void) {
    HID_Device_ProcessControlRequest(&HID_KeyboardInterface);
    HID_Device_ProcessControlRequest(&HID_MediaInterface);
}

void EVENT_USB_Device_StartOfFrame(void) {
    HID_Device_MillisecondElapsed(&HID_KeyboardInterface);
    HID_Device_MillisecondElapsed(&HID_MediaInterface);
}

void EVENT_USB_Device_Connect(void) { }
void EVENT_USB_Device_Disconnect(void) { }

/* ---------------------------------------------------------
 * Hardware Interrupt Sequence Vector
 * --------------------------------------------------------- */
ISR(USART1_RX_vect, ISR_BLOCK)
{
     // ALWAYS read first to clear the flag and prevent hardware lockups
     uint8_t ReceivedByte = UDR1;

     // Append standard byte array values into the local circular parser ring allocation structure
     if (parserCount < SERIAL_PARSER_BUFFER_SIZE)
     {
         parserBuffer[parserHead] = ReceivedByte;
         parserHead = (parserHead + 1) % SERIAL_PARSER_BUFFER_SIZE;
         parserCount++;
     }
}
