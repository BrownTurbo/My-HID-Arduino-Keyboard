  31:Descriptors.c **** /** \file
  32:Descriptors.c ****  *
  33:Descriptors.c ****  *  USB Device Descriptors, for library use when in USB device mode. Descriptors are special 
  34:Descriptors.c ****  *  computer-readable structures which the host requests upon device enumeration, to determine
  35:Descriptors.c ****  *  the device's capabilities and functions.  
  36:Descriptors.c ****  */
  37:Descriptors.c **** 
  38:Descriptors.c **** #include "Descriptors.h"
  39:Descriptors.c **** #include <LUFA/Drivers/USB/Class/HID.h>
  40:Descriptors.c **** 
  41:Descriptors.c **** /** HID class report descriptor. This is a special descriptor constructed with values from the
  42:Descriptors.c ****  *  USBIF HID class specification to describe the reports and capabilities of the HID device. This
  43:Descriptors.c ****  *  descriptor is parsed by the host and its contents used to determine what data (and in what enco
  44:Descriptors.c ****  *  the device will send, and what it may be sent back from the host. Refer to the HID specificatio
  45:Descriptors.c ****  *  more details on HID report descriptors.
  46:Descriptors.c ****  */
  47:Descriptors.c **** const USB_Descriptor_HIDReport_Datatype_t PROGMEM KeyboardReport[] =
  48:Descriptors.c **** {
  49:Descriptors.c ****     0x05, 0x01,          /* Usage Page (Generic Desktop) */
  50:Descriptors.c ****     0x09, 0x06,          /* Usage (Keyboard) */
  51:Descriptors.c ****     0xA1, 0x01,          /* Collection (Application) */
  52:Descriptors.c ****     
  53:Descriptors.c ****     /* Modifiers (8 bits) */
  54:Descriptors.c ****     0x05, 0x07,          /* Usage Page (Key Codes) */
  55:Descriptors.c ****     0x19, 0xE0,          /* Usage Minimum (Keyboard LeftControl) */
  56:Descriptors.c ****     0x29, 0xE7,          /* Usage Maximum (Keyboard Right GUI) */
  57:Descriptors.c ****     0x15, 0x00,          /* Logical Minimum (0) */
  58:Descriptors.c ****     0x25, 0x01,          /* Logical Maximum (1) */
  59:Descriptors.c ****     0x75, 0x01,          /* Report Size (1 bit) */
  60:Descriptors.c ****     0x95, 0x08,          /* Report Count (8 fields) */
  61:Descriptors.c ****     0x81, 0x02,          /* Input (Data, Variable, Absolute) */
  62:Descriptors.c ****     
  63:Descriptors.c ****     /* Reserved Byte (1 byte padding) */
  64:Descriptors.c ****     0x95, 0x01,          /* Report Count (1 field) */
  65:Descriptors.c ****     0x75, 0x08,          /* Report Size (8 bits) */
  66:Descriptors.c ****     0x81, 0x03,          /* Input (Constant, Variable, Absolute) */
  67:Descriptors.c ****     
  68:Descriptors.c ****     /* LED Status Outputs (5 bits) */
  69:Descriptors.c ****     0x05, 0x08,          /* Usage Page (LEDs) */
  70:Descriptors.c ****     0x19, 0x01,          /* Usage Minimum (Num Lock) */
  71:Descriptors.c ****     0x29, 0x05,          /* Usage Maximum (Kana) */
  72:Descriptors.c ****     0x95, 0x05,          /* Report Count (5 fields) */
  73:Descriptors.c ****     0x75, 0x01,          /* Report Size (1 bit) */
  74:Descriptors.c ****     0x91, 0x02,          /* Output (Data, Variable, Absolute) */
  75:Descriptors.c ****     
  76:Descriptors.c ****     /* LED Padding (3 bits) */
  77:Descriptors.c ****     0x95, 0x01,          /* Report Count (1 field) */
  78:Descriptors.c ****     0x75, 0x03,          /* Report Size (3 bits) */
  79:Descriptors.c ****     0x91, 0x03,          /* Output (Constant, Variable, Absolute) */
  80:Descriptors.c ****     
  81:Descriptors.c ****     /* Keycode Array (6 bytes) */
  82:Descriptors.c ****     0x15, 0x00,          /* Logical Minimum (0) */
  83:Descriptors.c ****     0x25, 0xFF,          /* Logical Maximum (255) */
  84:Descriptors.c ****     0x05, 0x07,          /* Usage Page (Key Codes) */
  85:Descriptors.c ****     0x19, 0x00,          /* Usage Minimum (0) */
  86:Descriptors.c ****     0x29, 0xFF,          /* Usage Maximum (255) */
  87:Descriptors.c ****     0x95, 0x06,          /* Report Count (6 fields) */
  88:Descriptors.c ****     0x75, 0x08,          /* Report Size (8 bits) */
  89:Descriptors.c ****     0x81, 0x00,          /* Input (Data, Array, Absolute) */
  90:Descriptors.c ****     
  91:Descriptors.c ****     0xC0                 /* End Collection */
  92:Descriptors.c **** };
  93:Descriptors.c **** 
  94:Descriptors.c **** const USB_Descriptor_HIDReport_Datatype_t PROGMEM MediaReport[] =
  95:Descriptors.c **** {
  96:Descriptors.c ****     0x05, 0x0C,          /* Usage Page (Consumer) */
  97:Descriptors.c ****     0x09, 0x01,          /* Usage (Consumer Control) */
  98:Descriptors.c ****     0xA1, 0x01,          /* Collection (Application) */
  99:Descriptors.c ****     
 100:Descriptors.c ****     0x15, 0x00,          /* Logical Minimum (0) */
 101:Descriptors.c ****     0x26, 0xFF, 0x03,    /* Logical Maximum (1023) - 16-bit little endian */
 102:Descriptors.c ****     0x19, 0x00,          /* Usage Minimum (0) */
 103:Descriptors.c ****     0x2A, 0xFF, 0x03,    /* Usage Maximum (1023) - 16-bit little endian */
 104:Descriptors.c ****     0x75, 0x10,          /* Report Size (16 bits) */
 105:Descriptors.c ****     0x95, 0x01,          /* Report Count (1 field) */
 106:Descriptors.c ****     0x81, 0x00,          /* Input (Data, Array, Absolute) */
 107:Descriptors.c ****     
 108:Descriptors.c ****     0xC0                 /* End Collection */
 109:Descriptors.c **** };
