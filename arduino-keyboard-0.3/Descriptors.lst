  89:Descriptors.c **** const USB_Descriptor_HIDReport_Datatype_t PROGMEM MediaReport[] =
  90:Descriptors.c **** {
  91:Descriptors.c **** 	0x05, 0x0C,          // USAGE_PAGE (Consumer Devices)
  92:Descriptors.c **** 	0x09, 0x01,          // USAGE (Consumer Control)
  93:Descriptors.c **** 	0xA1, 0x01,          // COLLECTION (Application)
  94:Descriptors.c **** 	0x09, 0xE9,          //   USAGE (Volume Up)
  95:Descriptors.c **** 	0x09, 0xEA,          //   USAGE (Volume Down)
  96:Descriptors.c **** 	0x09, 0xE2,          //   USAGE (Mute)
  97:Descriptors.c **** 	0x09, 0xCD,          //   USAGE (Play/Pause)
  98:Descriptors.c **** 	0x15, 0x00,          //   LOGICAL_MINIMUM (0)
  99:Descriptors.c **** 	0x25, 0x01,          //   LOGICAL_MAXIMUM (1)
 100:Descriptors.c **** 	0x75, 0x01,          //   REPORT_SIZE (1 bit per key)
 101:Descriptors.c **** 	0x95, 0x04,          //   REPORT_COUNT (4 media actions)
 102:Descriptors.c **** 	0x81, 0x02,          //   INPUT (Data, Var, Abs)
 103:Descriptors.c **** 	0x95, 0x04,          //   REPORT_COUNT (4 padding bits)
 104:Descriptors.c **** 	0x81, 0x03,          //   INPUT (Const, Var, Abs)
 105:Descriptors.c **** 	0xC0                 // END_COLLECTION
 106:Descriptors.c **** };
