 111:Descriptors.c **** /** Device descriptor structure. This descriptor, located in FLASH memory, describes the overall
 112:Descriptors.c ****  *  device characteristics, including the supported USB version, control endpoint size and the
 113:Descriptors.c ****  *  number of device configurations. The descriptor is read out by the USB host when the enumeratio
 114:Descriptors.c ****  *  process begins.
 115:Descriptors.c ****  */
 116:Descriptors.c **** const USB_Descriptor_Device_t PROGMEM DeviceDescriptor =
 117:Descriptors.c **** {
 118:Descriptors.c **** 	.Header                 = {.Size = sizeof(USB_Descriptor_Device_t), .Type = DTYPE_Device},
 119:Descriptors.c **** 		
 120:Descriptors.c **** 	.USBSpecification       = VERSION_BCD(01.10),
 121:Descriptors.c ****     .Class                  = 0xEF, 
 122:Descriptors.c ****     .SubClass               = 0x02,
 123:Descriptors.c ****     .Protocol               = 0x01,
 124:Descriptors.c **** 				
 125:Descriptors.c **** 	.Endpoint0Size          = FIXED_CONTROL_ENDPOINT_SIZE,
 126:Descriptors.c **** 			
 127:Descriptors.c **** 	.VendorID               = 0x03EB,
 128:Descriptors.c **** 	.ProductID              = 0x2042,
 129:Descriptors.c **** 	.ReleaseNumber          = 0x0001,
 130:Descriptors.c **** 		
 131:Descriptors.c **** 	.ManufacturerStrIndex   = 0x01,
 132:Descriptors.c **** 	.ProductStrIndex        = 0x02,
 133:Descriptors.c **** 	.SerialNumStrIndex      = NO_DESCRIPTOR,
 134:Descriptors.c **** 		
 135:Descriptors.c **** 	.NumberOfConfigurations = FIXED_NUM_CONFIGURATIONS
 136:Descriptors.c **** };
