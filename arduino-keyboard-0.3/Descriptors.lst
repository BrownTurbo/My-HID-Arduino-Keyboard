  31:Descriptors.c **** /** \file
  32:Descriptors.c ****  *
  33:Descriptors.c ****  *  USB Device Descriptors, for library use when in USB device mode. Descriptors are special 
  34:Descriptors.c ****  *  computer-readable structures which the host requests upon device enumeration, to determine
  35:Descriptors.c ****  *  the device's capabilities and functions.  
  36:Descriptors.c ****  */
  37:Descriptors.c **** 
  38:Descriptors.c **** #include "Descriptors.h"
  39:Descriptors.c **** 
  40:Descriptors.c **** /** HID class report descriptor. This is a special descriptor constructed with values from the
  41:Descriptors.c ****  *  USBIF HID class specification to describe the reports and capabilities of the HID device. This
  42:Descriptors.c ****  *  descriptor is parsed by the host and its contents used to determine what data (and in what enco
  43:Descriptors.c ****  *  the device will send, and what it may be sent back from the host. Refer to the HID specificatio
  44:Descriptors.c ****  *  more details on HID report descriptors.
  45:Descriptors.c ****  */
  46:Descriptors.c **** const USB_Descriptor_HIDReport_Datatype_t PROGMEM KeyboardReport[] =
  47:Descriptors.c **** {
  48:Descriptors.c ****     0x05, 0x01,          /* Usage Page (Generic Desktop)                    */
  49:Descriptors.c ****     0x09, 0x06,          /* Usage (Keyboard)                                */
  50:Descriptors.c ****     0xa1, 0x01,          /* Collection (Application)                        */
  51:Descriptors.c ****     
  52:Descriptors.c ****     0x85, 0x01,          /* REPORT_ID (1) <-- CRITICAL: Defines the Keyboard Interface ID */
  53:Descriptors.c ****     
  54:Descriptors.c ****     0x75, 0x01,          /* Report Size (1)                               */
  55:Descriptors.c ****     0x95, 0x08,          /* Report Count (8)                              */
  56:Descriptors.c ****     0x05, 0x07,          /* Usage Page (Key Codes)                        */
  57:Descriptors.c ****     0x19, 0xe0,          /* Usage Minimum (Keyboard LeftControl)          */
  58:Descriptors.c ****     0x29, 0xe7,          /* Usage Maximum (Keyboard Right GUI)            */
  59:Descriptors.c ****     0x15, 0x00,          /* Logical Minimum (0)                           */
  60:Descriptors.c ****     0x25, 0x01,          /* Logical Maximum (1)                           */
  61:Descriptors.c ****     0x81, 0x02,          /* Input (Data, Variable, Absolute)              */
  62:Descriptors.c ****     
  63:Descriptors.c ****     0x95, 0x01,          /* Report Count (1)                              */
  64:Descriptors.c ****     0x75, 0x08,          /* Report Size (8)                               */
  65:Descriptors.c ****     0x81, 0x03,          /* Input (Const, Variable, Absolute)             */
  66:Descriptors.c ****     
  67:Descriptors.c ****     0x95, 0x05,          /* Report Count (5)                              */
  68:Descriptors.c ****     0x75, 0x01,          /* Report Size (1)                               */
  69:Descriptors.c ****     0x05, 0x08,          /* Usage Page (LEDs)                             */
  70:Descriptors.c ****     0x19, 0x01,          /* Usage Minimum (Num Lock)                      */
  71:Descriptors.c ****     0x29, 0x05,          /* Usage Maximum (Kana)                          */
  72:Descriptors.c ****     0x91, 0x02,          /* Output (Data, Variable, Absolute)             */
  73:Descriptors.c ****     
  74:Descriptors.c ****     0x95, 0x01,          /* Report Count (1)                              */
  75:Descriptors.c ****     0x75, 0x03,          /* Report Size (3)                               */
  76:Descriptors.c ****     0x91, 0x03,          /* Output (Const, Variable, Absolute)            */
  77:Descriptors.c ****     
  78:Descriptors.c ****     0x95, 0x06,          /* Report Count (6)                              */
  79:Descriptors.c ****     0x75, 0x08,          /* Report Size (8)                               */
  80:Descriptors.c ****     0x15, 0x00,          /* Logical Minimum (0)                           */
  81:Descriptors.c ****     0x26, 231, 0,        /* Logical Maximum (231)                         */
  82:Descriptors.c ****     0x05, 0x07,          /* Usage Page (Keyboard)                         */
  83:Descriptors.c ****     0x19, 0x00,          /* Usage Minimum (Reserved (no event indicated)) */
  84:Descriptors.c ****     0x29, 231,           /* Usage Maximum (Keyboard Application)          */
  85:Descriptors.c ****     0x81, 0x00,          /* Input (Data, Array, Absolute)                 */
  86:Descriptors.c ****     0xc0,                /* End Collection (Keyboard Application)            */
  87:Descriptors.c **** };
