 108:Descriptors.c **** /** Device descriptor structure. This descriptor, located in FLASH memory, describes the overall
 109:Descriptors.c ****  *  device characteristics, including the supported USB version, control endpoint size and the
 110:Descriptors.c ****  *  number of device configurations. The descriptor is read out by the USB host when the enumeratio
 111:Descriptors.c ****  *  process begins.
 112:Descriptors.c ****  */
 113:Descriptors.c **** const USB_Descriptor_Device_t PROGMEM DeviceDescriptor =
 114:Descriptors.c **** {
 115:Descriptors.c **** 	.Header                 = {.Size = sizeof(USB_Descriptor_Device_t), .Type = DTYPE_Device},
 116:Descriptors.c **** 		
 117:Descriptors.c **** 	.USBSpecification       = VERSION_BCD(01.10),
 118:Descriptors.c **** 	.Class                  = 0x00,
 119:Descriptors.c **** 	.SubClass               = 0x00,
 120:Descriptors.c **** 	.Protocol               = 0x00,
 121:Descriptors.c **** 				
 122:Descriptors.c **** 	.Endpoint0Size          = FIXED_CONTROL_ENDPOINT_SIZE,
 123:Descriptors.c **** 		
 124:Descriptors.c **** 	.VendorID               = 0x03EB,
 125:Descriptors.c **** 	.ProductID              = 0x2043,
 126:Descriptors.c **** 	.ReleaseNumber          = 0x0001,
 127:Descriptors.c **** 		
 128:Descriptors.c **** 	.ManufacturerStrIndex   = 0x01,
 129:Descriptors.c **** 	.ProductStrIndex        = 0x02,
 130:Descriptors.c **** 	.SerialNumStrIndex      = NO_DESCRIPTOR,
 131:Descriptors.c **** 		
 132:Descriptors.c **** 	.NumberOfConfigurations = FIXED_NUM_CONFIGURATIONS
 133:Descriptors.c **** };
